rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile: authenticated users can read and write only their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Module access collection:
    // Regular users can ONLY read their own module permissions.
    // Development/admin writing allowed for admin email or dev testing mode.
    match /user_access/{accessId} {
      allow read: if request.auth != null && (
        resource == null || resource.data.userId == request.auth.uid
      );
      allow write: if request.auth != null && (
        request.auth.token.email == 'felipelevantese@gmail.com' ||
        (request.resource.data.userId == request.auth.uid && request.resource.data.source == 'admin_dev')
      );
    }
  }
}

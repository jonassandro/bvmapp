rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile: authenticated users can read and write only their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Module access collection:
    // Regular users can ONLY read their own module permissions (by userId or authenticated email).
    // Production lock: Clients CANNOT create, update or delete user_access. Only Firebase Admin SDK (Yampi Webhook) can write.
    match /user_access/{accessId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        (request.auth.token.email != null && resource.data.email == request.auth.token.email)
      );
      allow write: if false;
    }
  }
}
